# Copy this file to .env (or set these as real environment variables) and fill in your key.
GEMINI_API_KEY=your-gemini-api-key-here
FLASK_SECRET_KEY=change-this-to-something-random

# Two shared passcodes for the /passcode login screen.
# SITE_PASSCODE unlocks full admin access (upload, edit, delete, clear data).
# VIEWER_PASSCODE unlocks read-only access plus the cosmetic settings page.
SITE_PASSCODE=change-this-admin-code
VIEWER_PASSCODE=change-this-viewer-code
